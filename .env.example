# Copy to .env and fill in. Generate tokens with:  openssl rand -hex 32

# Domain pointing at this server (used by Caddy for HTTPS)
DOMAIN=wake.example.com

# Token you type into the web page (or send as "Authorization: Bearer ..." from scripts)
ACCESS_TOKEN=

# Token the MikroTik router uses to poll /api/router/poll (must differ from ACCESS_TOKEN)
ROUTER_TOKEN=

# A wake request switches itself off after this many minutes if the PC never comes online
WAKE_TIMEOUT_MINUTES=10
